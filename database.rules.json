{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || (data.exists() && !newData.exists() && auth.token.admin === true))"
      }
    },
    "districts": {
      ".read": "auth != null",
      "$districtId": {
        ".write": "auth != null && ((!data.exists() && newData.child('adminId').val() === auth.uid) || data.child('adminId').val() === auth.uid || data.child('adminIds').child(auth.uid).val() === true || data.child('memberIds').child(auth.uid).val() === true)"
      }
    },
    "invites": {
      ".read": "auth != null",
      "$inviteId": {
        ".write": "auth != null && ((!data.exists() && newData.child('fromUserId').val() === auth.uid) || data.child('fromUserId').val() === auth.uid || data.child('toUserId').val() === auth.uid)"
      }
    },
    "userConversations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$conversationId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true || newData.root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true)"
        }
      }
    },
    "conversationMembers": {
      "$conversationId": {
        ".read": "auth != null && data.child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || data.parent().child(auth.uid).val() === true || newData.parent().child(auth.uid).val() === true)"
        }
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth != null && root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true",
        "messages": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.child('fromId').val() === auth.uid && (root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true || newData.root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true)",
            ".validate": "!newData.exists() || (newData.hasChildren(['fromId','toId','text','timestamp']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 4000 && newData.child('timestamp').isNumber())",
            "read": {
              ".write": "auth != null && data.parent().child('toId').val() === auth.uid && newData.val() === true",
              ".validate": "newData.isBoolean()"
            },
            "reactions": {
              "$emoji": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid && root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true",
                  ".validate": "!newData.exists() || newData.val() === true"
                }
              }
            }
          }
        }
      }
    },
    "privateLocations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('lat').val() >= -90 && newData.child('lat').val() <= 90 && newData.child('lng').val() >= -180 && newData.child('lng').val() <= 180)"
      }
    },
    "privateUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('isOnline').isBoolean() && newData.child('lastSeen').isNumber())"
      }
    },
    "likes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$likerId": {
          ".write": "auth != null && auth.uid === $likerId && $uid !== auth.uid",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "outgoingLikes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$targetId": {
          ".write": "auth != null && auth.uid === $uid && $targetId !== auth.uid",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "dislikes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$targetId": {
          ".write": "auth != null && auth.uid === $uid && $targetId !== auth.uid",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "matches": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "profileViews": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$viewerId": {
          ".write": "auth != null && auth.uid === $viewerId && $uid !== auth.uid",
          ".validate": "!newData.exists() || newData.isNumber()"
        }
      }
    }
  }
}
